   "sights": [
    {
     "kind": "see",
     "name": "Byōdō-in Temple",
     "lat": 34.889444,
     "lng": 135.807778,
     "hours": "Mar-Nov: daily 08:30-17:30, Dec-Feb: daily 09:00-16:30",
     "price": "Entrance to the temple grounds and museum is ¥600. Those who wish to enter the Phoenix Hall must pay an additional ¥300",
     "wikidata": "Q61094",
     "content": "The Byōdō-in was built by Fujiwara Yorimichi, the Chief Adviser to the Emperor, in 1053. It was built as a rural villa owned by his father. Yorimichi built the temple in response to the prevalent fear that a dark age was about to dawn, and ",
     "editions": 37,
     "unesco": true
    },
    {
     "kind": "see",
     "name": "Ujigami Shrine",
     "lat": 34.892067,
     "lng": 135.811439,
     "hours": "",
     "price": "Free",
     "wikidata": "Q583589",
     "content": "This modest little shrine is another one of Uji's historic monuments recognized as a [[UNESCO",
     "editions": 20,
     "unesco": true
    },
    {
     "kind": "see",
     "name": "Uji Shrine",
     "lat": 34.891047,
     "lng": 135.8107,
     "hours": "",
     "price": "Free",
     "wikidata": "Q12742788",
     "content": "The Uji shrine and the Ujigami shrine next door used to be part of the same complex, then known as Rikyukamisha. An interesting feature is the rabbit sculpture, which is said to have prevented the deity from getting lost.",
     "editions": 7
    },
    {
     "kind": "see",
     "name": "Kōshō-ji Temple",
     "lat": 34.8901,
     "lng": 135.813,
     "hours": "",
     "price": "",
     "wikidata": "Q11613456",
     "content": "A Zen temple that features a long, justly-famous tree-covered approach from the river. It's a lovely walk in the autumn. Kosho-ji is a working temple, so while visitors can walk the grounds, the temple buildings themselves are frequently in",
     "editions": 5
    },
    {
     "kind": "see",
     "name": "Mimuroto-ji Temple",
     "lat": 34.900478,
     "lng": 135.819194,
     "hours": "",
     "price": "Entrance is ¥500",
     "wikidata": "Q11355140",
     "content": "One of the settings of the Tale of Genji, as well as the 10th temple along the Saigoku 33 Kannon Temple Pilgrimage Route. This temple will be of high interest to those who love flowers and gardens. Around the temple, lotus flowers have been",
     "editions": 5
    },
    {
     "kind": "see",
     "name": "Mampuku-ji Temple",
     "lat": 34.913889,
     "lng": 135.8075,
     "hours": "",
     "price": "",
     "wikidata": "Q576318",
     "content": "This is the head temple of the Japanese Ōbaku Zen sect, which is considered to be more Chinese than the other two sects (Rinzai and Soto). You can see the Chinese influences in the architecture, as the roofs were built in the Ming Dynasty s",
     "editions": 14
    },
    {
     "kind": "see",
     "name": "Nintendo Museum",
     "lat": 34.8927,
     "lng": 135.784,
     "hours": "Daily except Tuesdays 10:00 - 18:00",
     "price": "¥3300 for adult(18+),  ¥2200 for youth(12-17),¥1100 for children(6-11),free for preschooler(0-5)",
     "wikidata": "Q123124346",
     "content": "This video game giant converted their old plant into a museum for the company. Has many historical items in their collection, and interactive experiences for Nintendo products.",
     "editions": 13
    },
    {
     "kind": "see",
     "name": "Amagase Dam",
     "lat": 34.880833,
     "lng": 135.828056,
     "hours": "",
     "price": "",
     "wikidata": "Q4739121",
     "content": "This dam is south of the city. A scenic walkway leads there from Uji either shore of the river and the dam itself offers nice views.",
     "editions": 5
    }
   ],
