   "editions": 4,
   "unesco": false,
   "web": "http://www.museummaritimum.com",
   "en": "Maritime Museum of Montenegro in Kotor"
  },
  {
   "name": "Castle of San Giovanni",
   "lat": 42.422117,
   "lng": 18.774816,
   "wikidata": "",
   "note": "Ruins of a castle at the top of the trail running along the fortifications of the town. Offers panoramic views of the walled town with the Bay of Kotor in the background."
  },
  {
   "name": "Church of Our Lady of Remedy",
   "lat": 42.424286,
   "lng": 18.773204,
   "wikidata": "Q4981066",
   "note": "Church on the slopes of the mountain overlooking Kotor. Built in the 16th century by plague survivors to honor the Holy Mother. Accessed by climbing the trail up the fortifications from the old town.",
   "editions": 7,
   "unesco": false
  },
