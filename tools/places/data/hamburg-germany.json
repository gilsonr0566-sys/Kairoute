 "towns": {
  "bremen-far": {
   "name": "Bremen",
   "wikidata": "Q24879",
   "editions": 164,
   "unesco": true,
   "dayTripListed": true,
   "sights": [
    {
     "kind": "see",
     "name": "Rathaus",
     "lat": 53.0759,
     "lng": 8.8076,
     "hours": "Mon–Sat 11:00, 12:00, 15:00, 16:00; Sun 11:00, 12:00",
     "price": "€6.50",
     "wikidata": "Q19479",
     "content": "This is one of the finest in Europe and has been included on the UNESCO World Heritage List. Building work started in 1410 and it is seen as an important display of the wealth and freedom of the city.",
     "editions": 37,
     "unesco": true
    },
    {
     "kind": "see",
     "name": "Roland",
     "lat": 53.07591,
     "lng": 8.80733,
     "hours": "24/7",
     "price": "Free",
     "wikidata": "Q19665",
     "content": "This statue on the main square, in front of the town hall, is of the Knight Roland, subject of the Medieval epic, the Song of Roland, who was a protector of trade. He appears in many European cities, especially those involved in the Hanseat",
     "editions": 34,
     "unesco": true
    },
    {
     "kind": "see",
     "name": "Dom St. Petri",
     "lat": 53.075278,
     "lng": 8.808889,
     "hours": "Mon–Fri 10:00–17:00, Sat 10:00–14:00, Sun 14:00–17:00 (Check website for tower hours)",
     "price": "Free entry to cathedral; Tower and Museum: €3–5",
     "wikidata": "Q695038",
     "content": "Over 1,200 years old, its huge towered façade dominates the main square. The interior is also impressive, with some fine painted details on the ceilings. The cathedral was damaged by fire and lightning in the 17th century and also seriously",
     "editions": 23
    },
    {
     "kind": "see",
     "name": "Böttcherstraße",
     "lat": 53.075,
     "lng": 8.80556,
     "hours": "24/7",
     "price": "Free",
     "wikidata": "Q531367",
     "content": "An incredible ''Jugendstil'' (Art Nouveau) street that runs from the main square towards the river. There are many fine façades and courtyards all with large amounts of design detail. There is an impressive Glockenspiel that chimes at regul",
     "editions": 9
    },
    {
     "kind": "see",
     "name": "Wallanlagen",
     "lat": 53.07988,
     "lng": 8.80592,
     "hours": "24/7",
     "price": "Free",
     "wikidata": "",
     "content": "Built on the site of the former city fortifications, this star-shaped park is the oldest public garden in Germany. It features scenic walking paths, colorful flowerbeds, and the historic \"Am Wall\" windmill."
    },
    {
     "kind": "see",
     "name": "Schnoor",
     "lat": 53.0728,
     "lng": 8.80972,
     "hours": "24/7",
     "price": "Free",
     "wikidata": "Q538341",
     "content": "Bremen's oldest district, characterized by narrow lanes and timber-framed houses dating back to the 15th and 16th centuries. Once a quarter for fishermen and craftsmen, it now hosts numerous galleries, cafés, and small handicraft shops.",
     "editions": 11
    },
    {
     "kind": "see",
     "name": "Überseemuseum",
     "lat": 53.0833,
     "lng": 8.8106,
     "hours": "Tue-Fri 09:00-18:00, Sat Sun 10:00-18:00",
     "price": "Children €2.50, adults €7.50",
     "wikidata": "Q333527",
     "content": "",
     "editions": 7
    },
    {
     "kind": "see",
     "name": "Focke Museum",
     "lat": 53.09152,
     "lng": 8.86421,
     "hours": "Tue 10:00-21:00, Wed-Sat 10:00-17:00, Sun 10:00-18:00",
     "price": "permanent exhibition €6, children €2, and special exhibition €8, children €4",
     "wikidata": "Q1434990",
     "content": "A good overview of the history of Bremen City with a wide range of collections.",
     "editions": 4
    },
    {
     "kind": "see",
     "name": "Universum Science Center",
     "lat": 53.106389,
     "lng": 8.844722,
     "hours": "Mon-Fri 09:00 - 18:00, Sat Sun 10:00 - 18:00",
     "price": "Adults €16, children €11, family card €40",
     "wikidata": "Q882811",
     "content": "Science museum with plenty of interactive exhibits such as an earthquake simulator. The main building is a huge steel shell designed by the Bremen architect Thomas Klumpp.",
     "editions": 7
    },
